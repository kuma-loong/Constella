$background: #0B0E14;
$surface: #131822;
$surface-raised: #182033;
$selection: #1E2538;
$line: #2B334A;
$text: #E2E8F0;
$muted: #8A99AD;
$accent: #00E5FF;
$accent-strong: #B9F7FF;
$online: #38BDF8;
$purple: #A855F7;
$warning: #FF6B00;
$danger: #FF2A5F;

Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#topbar {
    width: 100%;
    height: 3;
    background: $background;
    border-bottom: solid $line;
}

#brand {
    width: 22;
    height: 100%;
    padding: 1 0 0 2;
    color: $text;
    text-style: bold;
}

#view-nav {
    width: 1fr;
    height: 100%;
    padding-top: 1;
    content-align: center top;
    text-align: center;
}

#connection-status {
    width: 14;
    height: 100%;
    padding: 1 2 0 0;
    text-align: right;
    text-style: bold;
}

#connection-status.live { color: $accent; }
#connection-status.connecting { color: $warning; }
#connection-status.error { color: $danger; }

#context-bar {
    height: 2;
    padding: 0 2;
    background: #101621;
    border-bottom: solid $line;
    color: $muted;
    content-align: left middle;
}

#views, .view {
    width: 100%;
    height: 1fr;
    background: $background;
}

#overview-workspace { width: 100%; height: 1fr; }

#node-pane {
    width: 25;
    min-width: 22;
    max-width: 30;
    height: 100%;
    background: $surface;
    border-right: solid $line;
}

#overview-detail { width: 1fr; height: 100%; }

#node-summary {
    height: 2;
    padding: 0 1;
    background: $background;
    border-bottom: solid $line;
    content-align: left middle;
}

.section-title {
    height: 2;
    padding: 0 1;
    background: $surface-raised;
    color: $accent;
    text-style: bold;
    content-align: left middle;
}

#nodes {
    height: 1fr;
    padding: 1 0;
    background: $surface;
}

#nodes ListItem {
    height: 4;
    padding: 1 1 0 2;
    color: $muted;
    border-left: tall transparent;
}

#nodes ListItem:hover { background: #192033; color: $text; }
#nodes ListItem.-highlight {
    background: $selection;
    color: #FFFFFF;
    border-left: tall $accent;
    text-style: bold;
}
#nodes ListItem.-highlight Label { color: #FFFFFF; }
#nodes ListItem.status-online { color: $muted; }
#nodes ListItem.status-offline, #nodes ListItem.status-stale { color: $danger; }
#nodes:focus { border: none; }

#gpus {
    height: auto;
    min-height: 4;
    max-height: 15;
}

#gpu-lower-pane {
    width: 100%;
    height: 1fr;
    border-top: solid $line;
}

#realtime-pane { width: 2fr; height: 100%; border-right: solid $line; }
#process-pane { width: 3fr; height: 100%; }

#realtime-curve, .history-curve {
    width: 100%;
    height: 1fr;
    padding: 1;
    background: $background;
    color: $accent;
    overflow: hidden;
}

#processes { height: auto; min-height: 4; max-height: 12; }
#gpu-facts {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: $background;
    overflow: hidden;
}

#state-message {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $muted;
}

#cluster-view { layout: vertical; }
#cluster-nodes { height: auto; min-height: 4; max-height: 18; }
#node-hardware { height: 1fr; min-height: 8; }

.view-status {
    height: 2;
    padding: 0 1;
    background: #101621;
    border-bottom: solid $line;
    color: $muted;
    content-align: left middle;
}

#rankings-view { layout: vertical; }
#ranking-grid { width: 100%; height: 58%; min-height: 12; }
#ranking-grid > Vertical { width: 1fr; height: 100%; }
#ranking-grid > Vertical:first-child { border-right: solid $line; }
#user-rankings, #job-rankings { height: 1fr; }
#anomalies { height: 1fr; min-height: 8; }

#history-view { layout: vertical; }
#history-charts { width: 100%; height: 58%; min-height: 14; }
#history-charts > Vertical { width: 1fr; height: 100%; }
#history-charts > Vertical:first-child { border-right: solid $line; }
#history-heatmap {
    width: 100%;
    height: 1fr;
    min-height: 8;
    padding: 1 2;
    background: $background;
    overflow-x: auto;
    overflow-y: auto;
}

DataTable {
    width: 100%;
    background: $background;
    color: $text;
    scrollbar-color: $line;
    scrollbar-background: $background;
}

DataTable > .datatable--header {
    background: $surface;
    color: $muted;
    text-style: bold;
}

DataTable > .datatable--cursor { background: #1A2234; }
DataTable > .datatable--odd-row { background: #101620; }
DataTable:focus { border: none; }

Footer {
    height: 1;
    background: $surface-raised;
    color: $muted;
}

Footer > .footer--key { background: $accent; color: $background; text-style: bold; }
Footer > .footer--description { background: $surface-raised; color: $muted; }

HelpScreen { align: center middle; background: #0B0E14 85%; }

#help-dialog {
    width: 64;
    max-width: 90%;
    height: 21;
    background: $surface;
    border: solid $line;
    padding: 1 2;
}

#help-copy { height: 1fr; padding: 1 0; color: $text; }
#help-close { height: 1; color: $muted; text-align: center; }
